// Open the project through this file.
// Editor settings live only here; tasks, launch configurations and extension
// recommendations live only in .vscode/. Do not add .vscode/settings.json.
{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    // Every versioned file is UTF-8 with LF line endings and a final newline.
    "files.encoding": "utf8",
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,

    // HTML, CSS, JavaScript, JSON, YAML and XML use 2 spaces; Python and shell use 4.
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.tabSize": 2,
    "[python]": {
      "editor.tabSize": 4
    },
    "[shellscript]": {
      "editor.tabSize": 4
    },
    "[markdown]": {
      "files.trimTrailingWhitespace": false
    },

    // No formatter is configured; formatters would undo the aligned assignments in the scripts.
    "editor.formatOnSave": false,

    // Generated by build-site.py or third-party: read-only and left out of search.
    "files.readonlyInclude": {
      "assets/catalog-data.js": true,
      "assets/main.min.js": true,
      "assets/jszip.min.js": true
    },
    "search.exclude": {
      "assets/catalog-data.js": true,
      "assets/main.min.js": true,
      "assets/jszip.min.js": true
    },
    "files.exclude": {
      "**/__pycache__": true
    },

    // Same test run as the Build and tests workflow.
    "python.testing.unittestEnabled": true,
    "python.testing.pytestEnabled": false,
    "python.testing.unittestArgs": ["-v", "-s", "./tests", "-p", "test_*.py"]
  }
}
