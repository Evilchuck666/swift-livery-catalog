# Local assets: images, fonts and thumbnails are not versioned.
# Only resources/about/ (About tab) and resources/scripts/ (build tooling) are.
/resources/*
!/resources/about/
!/resources/scripts/

# Generated by resources/scripts/build-site.py
/assets/catalog-data.js
/assets/main.min.js

# Third-party library for the ZIP download
/assets/jszip.min.js

# Python bytecode (tests, py_compile) and local virtual environment (Pillow)
__pycache__/
*.py[cod]
/.venv/

# Blender files and backups written by resources/scripts/blender/
*.blend
*.blend[0-9]*

# SFTP extension credentials, also read by resources/scripts/deploy-mirror.py
/.vscode/sftp.json

# Other editors
/.idea/

# OS files
.DS_Store
Thumbs.db
